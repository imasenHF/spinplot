{
  "name": "spinplot",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts --ext .js,.mjs",
    "format:check": "prettier --check package.json eslint.config.js .prettierrc.json scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "jspdf": "4.0.0",
    "svg2pdf.js": "2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2"
  }
}
